<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Sample Conversation Access</label>
    <description
  >Grants access to Sample Conversation records, the Sample Conversation Player controller, and the Sample Conversations tab.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>SampleConversationController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AgentforceService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CoworkerSkillsController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <object>Sample_Conversation__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Sample_Conversation__c.Transcript__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Sample_Conversation__c.Skill_API_Name__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Sample_Conversation__c.Agent_API_Name__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Sample_Conversation__c.Description__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Sample_Conversation__c.Last_Play_Duration__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <tabSettings>
        <tab>Sample_Conversation__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Sample_Conversations_Home</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
