<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Sample Conversation Player</masterLabel>
    <description
  >Plays a stored Sample Conversation against an Agentforce agent and rewrites each Agent turn with the live response.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Sample_Conversation__c</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
